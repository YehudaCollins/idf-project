MONGODB_URI=mongodb://127.0.0.1:27017/unitree
PORT=3002

# AI provider: mock | openai | azure-openai | alpha
# ברשת סגורה: alpha (מומלץ) או mock. OpenAI ציבורי רק בפיתוח פתוח.
AI_PROVIDER=mock

# --- Alpha AI (AI_PROVIDER=alpha) — token רק בשרת, לא VITE_ ---
# ALPHA_AI_ENABLED=true
# ALPHA_AI_API_BASE=https://alphaai.idf/api
# ALPHA_AI_MODEL=jack-auto
# ALPHA_AI_STREAM_ENDPOINT=/chat/jack-auto
# ALPHA_AI_TIMEOUT_MS=30000
# ALPHA_AI_STREAM_TIMEOUT_MS=120000
# ALPHA_AI_API_TOKEN=<provide via secure secret management>

# OpenAI ציבורי רק בסביבת פיתוח פתוחה. ברשת סגורה להשאיר ריק.
OPENAI_API_KEY=
OPENAI_MODEL=local-mock

# External API — מפתחות למערכות חיצוניות (מופרדים בפסיק)
EXTERNAL_API_KEY=unitree-dev-key-change-me

# Active Directory lookup via activedirectory2
ACTIVE_DIRECTORY_ENABLED=true
ACTIVE_DIRECTORY_URL=ldap://dc.domain.local
ACTIVE_DIRECTORY_BASE_DN=dc=domain,dc=local
ACTIVE_DIRECTORY_USERNAME=reader@domain.local
ACTIVE_DIRECTORY_PASSWORD=change-me
ACTIVE_DIRECTORY_SOURCE_SYSTEM=ActiveDirectory
ACTIVE_DIRECTORY_PERSONAL_NUMBER_ATTRIBUTES=sAMAccountName,employeeID,employeeNumber,userPrincipalName,mail,cn,displayName
ACTIVE_DIRECTORY_USER_ATTRIBUTES=dn,distinguishedName,userPrincipalName,sAMAccountName,mail,employeeID,employeeNumber,givenName,sn,cn,displayName,title,department,manager,telephoneNumber,mobile,physicalDeliveryOfficeName,company,memberOf,thumbnailPhoto,jpegPhoto
ACTIVE_DIRECTORY_ORG_PATH_ATTRIBUTE=department
ACTIVE_DIRECTORY_TITLE_ATTRIBUTE=title
ACTIVE_DIRECTORY_TIMEOUT_MS=8000
ACTIVE_DIRECTORY_CONNECT_TIMEOUT_MS=8000

# תמונות פרופיל: data:image, נתיבים יחסיים ו-hosts פנימיים בלבד.
# הוסף כאן שמות שרתים פנימיים שמחזירים PictureURL מ-SharePoint/AD.
PROFILE_IMAGE_ALLOWED_HOSTS=
ALLOW_INTERNAL_PROFILE_IMAGE_URLS=true

# Azure OpenAI (when AI_PROVIDER=azure-openai)
# AZURE_OPENAI_ENDPOINT=
# AZURE_OPENAI_API_KEY=...
# AZURE_OPENAI_DEPLOYMENT=gpt-4o-mini

# Auth: התחברות לפי פרופיל SharePoint דרך POST /api/auth/microsoft-profile
# הלקוח קורא GetMyProperties/currentUser ושולח לשרת — משתמש חדש נשמר אוטומטית.
